#!/usr/bin/env python3
"""Screenshots for the shell.

  freeze [--pointer] DIR OUTPUT...   one DIR/OUTPUT.ppm per screen
  crop [--copy-only] SRC X Y W H     keep a rectangle (pixels) of a frozen screen
  grab [--pointer] [--copy-only] -g GEOMETRY | -o OUTPUT
  delete PATH

crop and grab put the picture on the clipboard and, unless --copy-only, in
Pictures/Screenshots; they print "PATH WIDTH HEIGHT".

  record [--audio mic|system] -g GEOMETRY | -o OUTPUT   start; prints PATH
  status             "PATH SECONDS" while recording, else exit 1
  stop               finish the file

A recording is its own user unit, so it outlives a restart of the shell.
"""

import os
import re
import struct
import subprocess
import sys
import time
import zlib
from pathlib import Path


UNIT = "callisto-record.service"


def user_dir(kind: str, fallback: str) -> Path:
    try:
        found = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True).stdout.strip()
    except OSError:
        found = ""
    return Path(found) if found and Path(found) != Path.home() else Path.home() / fallback


def runtime() -> Path:
    return Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "callisto"


def folder(copy_only: bool) -> Path:
    path = runtime() / "shot" if copy_only else user_dir("PICTURES", "Pictures") / "Screenshots"
    path.mkdir(parents=True, exist_ok=True)
    return path


def unused(base: Path, kind: str, suffix: str) -> Path:
    stem = time.strftime(f"{kind} %Y-%m-%d %H-%M-%S")
    path, number = base / f"{stem}{suffix}", 1
    while path.exists():
        number += 1
        path = base / f"{stem} ({number}){suffix}"
    return path


def destination(copy_only: bool) -> Path:
    return unused(folder(copy_only), "Screenshot", ".png")


def recording() -> bool:
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", UNIT]).returncode == 0


def audio_source(which: str) -> str:
    """wf-recorder's audio flag: the default microphone, or what the speakers play."""
    target = "@DEFAULT_AUDIO_SOURCE@" if which == "mic" else "@DEFAULT_AUDIO_SINK@"
    found = subprocess.run(["wpctl", "inspect", target], capture_output=True, text=True, check=True).stdout
    name = re.search(r'node\.name = "([^"]+)"', found)
    if not name:
        raise SystemExit(f"callisto-shot: no {which} to record")
    return f"--audio={name.group(1)}" + ("" if which == "mic" else ".monitor")


def record(rest: list[str]) -> None:
    audio = []
    if rest[:1] == ["--audio"] and rest[1:2] in (["mic"], ["system"]):
        audio, rest = [audio_source(rest[1])], rest[2:]
    if len(rest) != 2 or rest[0] not in ("-g", "-o"):
        raise SystemExit(__doc__)
    if recording():
        raise SystemExit("callisto-shot: already recording")
    base = user_dir("VIDEOS", "Videos") / "Screencasts"
    base.mkdir(parents=True, exist_ok=True)
    path = unused(base, "Recording", ".mp4")
    runtime().mkdir(parents=True, exist_ok=True)
    (runtime() / "recording").write_text(str(path))
    subprocess.run(["systemctl", "--user", "reset-failed", UNIT], capture_output=True)
    # SIGINT lets wf-recorder close the file. The filter keeps both sides even,
    # which H.264 in 4:2:0 requires and a dragged region need not be.
    subprocess.run(["systemd-run", "--user", "--quiet", "--collect", f"--unit={UNIT}",
                    "--property=KillSignal=SIGINT", "--property=TimeoutStopSec=30",
                    "wf-recorder", *audio, *rest, "-x", "yuv420p",
                    "-F", "crop=trunc(iw/2)*2:trunc(ih/2)*2", "-f", str(path)], check=True)
    print(path)


def status() -> None:
    if not recording():
        raise SystemExit(1)
    since = subprocess.run(["systemctl", "--user", "show", "--value", "-p", "ActiveEnterTimestampMonotonic", UNIT],
                           capture_output=True, text=True, check=True).stdout.strip()
    print((runtime() / "recording").read_text(), max(0, int(time.monotonic() - int(since or 0) / 1e6)), sep="\t")


def read_ppm(path: str) -> tuple[int, int, bytes]:
    data = Path(path).read_bytes()
    # "P6\n<width> <height>\n255\n" then raw RGB, as grim writes it.
    magic, size, depth, pixels = data.split(b"\n", 3)
    width, height = map(int, size.split())
    if magic != b"P6" or depth != b"255" or len(pixels) < width * height * 3:
        raise SystemExit(f"callisto-shot: unexpected image {path}")
    return width, height, pixels


def png(width: int, height: int, rows) -> bytes:
    def chunk(kind: bytes, body: bytes) -> bytes:
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))

    packer = zlib.compressobj(6)
    packed = b"".join(packer.compress(b"\0" + row) for row in rows) + packer.flush()
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", packed) + chunk(b"IEND", b""))


def finish(path: Path) -> None:
    with path.open("rb") as image:
        header = image.read(24)
        width, height = struct.unpack(">II", header[16:24])
        image.seek(0)
        subprocess.run(["wl-copy", "--type", "image/png"], stdin=image, check=True)
    print(path, width, height, sep="\t")


def crop(source: str, x: int, y: int, w: int, h: int, copy_only: bool) -> None:
    width, height, pixels = read_ppm(source)
    x, y = max(0, min(x, width - 1)), max(0, min(y, height - 1))
    w, h = max(1, min(w, width - x)), max(1, min(h, height - y))
    rows = (pixels[(r * width + x) * 3:(r * width + x + w) * 3] for r in range(y, y + h))
    path = destination(copy_only)
    path.write_bytes(png(w, h, rows))
    finish(path)


def main(args: list[str]) -> None:
    if not args:
        raise SystemExit(__doc__)
    command, rest = args[0], args[1:]
    flags = {a for a in rest if a in ("--pointer", "--copy-only")}
    rest = [a for a in rest if a not in flags]
    pointer = ["-c"] if "--pointer" in flags else []
    copy_only = "--copy-only" in flags

    if command == "freeze":
        target = Path(rest[0])
        target.mkdir(parents=True, exist_ok=True, mode=0o700)
        for output in rest[1:]:
            subprocess.run(["grim", *pointer, "-t", "ppm", "-o", output, str(target / f"{output}.ppm")],
                           check=True)
    elif command == "crop":
        crop(rest[0], *(int(v) for v in rest[1:5]), copy_only)
    elif command == "grab" and len(rest) == 2 and rest[0] in ("-g", "-o"):
        path = destination(copy_only)
        subprocess.run(["grim", *pointer, rest[0], rest[1], str(path)], check=True)
        finish(path)
    elif command == "record":
        record(rest)
    elif command == "status":
        status()
    elif command == "stop":
        subprocess.run(["systemctl", "--user", "stop", UNIT], check=True)
    elif command == "delete":
        Path(rest[0]).unlink(missing_ok=True)
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
