# Callisto package selection — SYSTEM LAYER ONLY.
#
# Architecture follows the immutable-distro model: apt ships the operating
# system (boot, session, compositor, shell, plumbing), and graphical user
# applications come from Flatpak/Flathub — see the flatpak section below and
# the provisioning hook. Nothing here is a user-facing "app" unless it is
# part of the desktop furniture itself.
#
# Scope discipline: every package must justify its size on the squashfs.

# --- Boot & live system -------------------------------------------------------
linux-image-amd64
live-boot
live-config
live-config-systemd
systemd-sysv

# --- Core session infrastructure ----------------------------------------------
# Listed so the installer's autoremove keeps it: only live-config pulls it in.
sudo
dbus-user-session
# dbus-broker reuses the systemd activation environment — reference dbus-daemon
# can't unset vars, which is how stale session env leaks across logout/login.
dbus-broker
# libglib2.0-bin: gsettings + gdbus — the dark-mode propagation chain
# (gsettings → portal-gtk → flatpaks) is dead without them.
libglib2.0-bin
polkitd
hyprpolkitagent
seatd
network-manager
power-profiles-daemon
upower
systemd-timesyncd

# --- Audio ----------------------------------------------------------------------
pipewire
playerctl
pipewire-pulse
wireplumber
libspa-0.2-bluetooth
bluez

# --- Graphics & Wayland --------------------------------------------------------
mesa-vulkan-drivers
libgl1-mesa-dri
libegl-mesa0
mesa-utils
xwayland
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk

# --- Compositor & shell (trixie-backports, see archives/backports.pref.chroot) -
hyprland
quickshell
uwsm
qt6-wayland
qml6-module-qtquick-effects
# QT_QPA_PLATFORMTHEME=qt6ct (set in /etc/xdg/uwsm/env): Qt apps autoselect
# nothing useful on Hyprland sessions, and hyprqt6engine isn't packaged in
# Debian. The engine generates qt6ct's color scheme from the Triton tokens.
qt6ct
# The style Qt apps are drawn with.
kde-style-breeze

# --- Desktop furniture (part of the OS, not apps) -------------------------------
# fuzzel removed — the Triton launcher is the launcher
greetd
tuigreet
# mako-notifier removed — the shell IS the notification daemon
foot
wl-clipboard
cliphist
grim
slurp
wf-recorder
brightnessctl
hypridle
hyprlock
hyprsunset

# --- File management ------------------------------------------------------------
# Nautilus is the one GUI app from Debian: Flathub's build is end-of-life
# (3.28). gvfs gives it, the shell and portals trash, thumbnails, and mounts.
nautilus
gvfs
gvfs-backends

# --- Secrets & keyring --------------------------------------------------------------
# Flatpak apps expect org.freedesktop.secrets. gnome-keyring provides it
# today; oo7 is the intended replacement once Debian packages the daemon
# (only the library crate is in trixie).
gnome-keyring
# Unlocks the keyring at password login (not on the live ISO's autologin).
libpam-gnome-keyring
# --- Flatpak runtime --------------------------------------------------------------
flatpak

# --- Utilities -----------------------------------------------------------------
# python3 is load-bearing, not a utility: the theme engine (callisto-apply)
# is python. uwsm pulls it transitively but the OS must not depend on a
# transitive accident for its theming system.
python3
xdg-user-dirs
curl
jq
less
vim-tiny
htop
fastfetch
# Third-party installers ask it which Debian this is.
lsb-release

# --- An installed system ---------------------------------------------------------
locales
keyboard-configuration
# The console font and layout, and ckbcomp for the installer's keyboard preview.
console-setup
# Compressed swap in memory.
systemd-zram-generator
btrfs-progs
dosfstools

# --- Fonts ----------------------------------------------------------------------
fonts-jetbrains-mono
fonts-inter
fonts-noto-color-emoji
fonts-noto-cjk
