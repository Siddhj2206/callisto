# Hyprland, Quickshell, and their shared dependency chain exist only in
# trixie-backports. Pinning is required so transitive library dependencies
# (libaquamarine, libhyprutils, ...) also come from backports rather than
# resolving to older stable versions.
Package: hyprland hyprland-* quickshell libaquamarine* libhypr*
Pin: release a=trixie-backports
Pin-Priority: 600
