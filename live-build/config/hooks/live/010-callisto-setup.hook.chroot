#!/bin/sh
# 010-callisto-setup.hook.chroot — Callisto system provisioning.
#
# Runs inside the chroot near the end of live-build, after packages are
# installed and includes.chroot is overlaid. Everything here is computation
# that cannot be expressed as static files: service enablement, branding that
# derives from package state, and user provisioning glue.
#
# Must be idempotent in effect and must not fail the build over cosmetics.

set -eu

echo "callisto: running setup hook"

# --- Identity ------------------------------------------------------------------
echo "callisto" > /etc/hostname

cat > /etc/os-release <<'EOF'
PRETTY_NAME="Callisto OS"
NAME="Callisto"
VERSION_ID="0.1.0"
VERSION="0.1.0 (Phobos)"
ID=callisto
ID_LIKE=debian
HOME_URL="https://github.com/callisto-os"
DOCUMENTATION_URL="https://github.com/callisto-os/docs"
SUPPORT_URL="https://github.com/callisto-os/issues"
BUG_REPORT_URL="https://github.com/callisto-os/issues"
EOF

# dpkg origin so package-management tooling attributes the derivative correctly.
mkdir -p /etc/dpkg/origins
cat > /etc/dpkg/origins/callisto <<'EOF'
Vendor: Callisto
Vendor-URL: https://github.com/callisto-os
Parent: Debian
EOF
ln -sf callisto /etc/dpkg/origins/default

cat > /etc/issue <<'EOF'
Callisto OS \n \l

EOF

# --- Live user provisioning ---------------------------------------------------
# live-config's boot-time user creation uses a DES-crypt hash (8Ab05sVQ4LLps,
# literally "live") and modern shadow dropped DES validation — every login
# fails even though the account exists. We provision the live user here, in
# the image, with a yescrypt hash; live-config's user-setup then sees the
# user already in passwd and skips its own creation cleanly.
#
# Password is "live" — the standard live-boot convention. Autologin never
# asks for it, but sudo does, and a documented password beats a locked one.
if ! grep -q "^user:" /etc/passwd; then
    # Precomputed sha512-crypt of "live" — baked because neither openssl nor
    # python3 can be relied on inside the chroot at hook time.
    HASH='$6$rvJoS0qOC6hsFRth$pvMinYI2JNBGfGHThkHo/vsZRG8f3m3MlGleiMvPR5tUdBlW5W59mv/R9IqqiI5dmWO/kLlLMx8/KGM1/5A.B0'
    useradd -m -s /bin/bash -u 1000 \
        -G audio,video,input,render,netdev,sudo,users \
        -p "$HASH" \
        -c "Live user" user \
        || echo "callisto: WARNING user provisioning failed" >&2
    echo "callisto: live user provisioned (sha512 hash)"
fi

# The greeter user: tuigreet runs as this unprivileged account. Debian's
# greetd package does not create it.
if ! grep -q "^greeter:" /etc/passwd; then
    useradd -r -s /usr/sbin/nologin -c "greetd greeter" greeter 2>/dev/null \
        || useradd -r -s /usr/sbin/nologin greeter \
        || echo "callisto: WARNING greeter user creation failed" >&2
fi
# Its home, made at boot by tmpfiles.d/callisto-greeter.conf.
usermod -d /var/lib/callisto-greeter greeter \
    || echo "callisto: WARNING greeter home not set" >&2

# --- Session greeter -------------------------------------------------------------
# live-config auto-configures the autologin of known display managers but does
# not know greetd; we enable it explicitly. The [initial_session] in
# /etc/greetd/config.toml (delivered via includes.chroot) drops the live user
# straight into Hyprland on boot.
systemctl enable greetd.service || echo "callisto: WARNING could not enable greetd" >&2
systemctl set-default graphical.target || true

# --- User services ---------------------------------------------------------------
systemctl --global enable callisto-shell.service \
    || echo "callisto: WARNING could not enable the shell" >&2
systemctl --global enable callisto-clipboard.service \
    || echo "callisto: WARNING could not enable clipboard history" >&2
systemctl --global enable callisto-settingsd.socket callisto-settingsd.service \
    || echo "callisto: WARNING could not enable the settings daemon" >&2
systemctl --global enable callisto-install-hint.service \
    || echo "callisto: WARNING could not enable the install hint" >&2
chmod 0440 /etc/sudoers.d/callisto-live

# Disable other display managers if any snuck in as dependencies; greetd is the
# sole session entry point.
for dm in gdm3 gdm sddm lightdm; do
    if systemctl is-enabled "$dm" >/dev/null 2>&1; then
        systemctl disable "$dm" || true
    fi
done

# greetd owns VT1; a getty there races it on boot and fragments the session.
systemctl mask getty@tty1.service 2>/dev/null || true

# --- Desktop integration services ----------------------------------------------
# The polkit authentication agent runs as a systemd user unit — enabled for
# all users here (the modern autostart path; no exec-once in the compositor
# config). Without it every privileged action in the session silently fails.
systemctl --global enable hyprpolkitagent.service 2>/dev/null \
    || echo "callisto: WARNING could not enable hyprpolkitagent" >&2

# xdg-user-dirs-update creates ~/Documents ~/Downloads etc. on first login —
# flatpak file pickers and portals break in confusing ways without them.
systemctl --global enable xdg-user-dirs-update.service 2>/dev/null || true

# Appearance defaults through gsettings: xdg-desktop-portal-gtk re-publishes
# org.gnome.desktop.interface color-scheme as the freedesktop appearance
# portal key — this single key is how dark mode reaches GTK4/libadwaita,
# Firefox, Electron, and every flatpak. Seeding system-wide dconf defaults;
# the theme engine writes the per-user key on every apply.
mkdir -p /etc/dconf/db/local.d
cat > /etc/dconf/db/local.d/00-callisto <<'DCONF'
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita'
cursor-theme='Adwaita'
cursor-size=24
font-name='Inter 10'
DCONF
if [ -d /etc/dconf/db/local.d ] && command -v dconf >/dev/null 2>&1; then
    mkdir -p /etc/dconf/profile
    if [ ! -f /etc/dconf/profile/user ]; then
        printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
    fi
    dconf update 2>/dev/null || echo "callisto: WARNING dconf update failed" >&2
fi

# --- Hardware services -------------------------------------------------------------
systemctl enable power-profiles-daemon.service 2>/dev/null || true

# --- Fonts --------------------------------------------------------------------------
# The Triton faces ship in /usr/share/fonts/triton (includes.chroot).
fc-cache -f >/dev/null 2>&1 || true

# --- matugen ------------------------------------------------------------------------
# The theme engine's color brain. Not packaged in Debian; the upstream release
# binary (a static musl build) is fetched at build time and checked against a
# pinned hash. A build that cannot get exactly it fails.
MATUGEN_VERSION=4.2.0
MATUGEN_SHA256=a2e3b50e49ed6439999ba3c252ed04fabd98ee4e9d12e5e5dff2e66370569751
curl -fsSL --retry 3 --max-time 120 -o /tmp/matugen.tar.gz \
    "https://github.com/InioX/matugen/releases/download/v$MATUGEN_VERSION/matugen-$MATUGEN_VERSION-x86_64.tar.gz"
echo "$MATUGEN_SHA256  /tmp/matugen.tar.gz" | sha256sum -c -
tar -xzf /tmp/matugen.tar.gz -C /tmp matugen
install -m 0755 /tmp/matugen /usr/local/bin/matugen
rm -f /tmp/matugen.tar.gz /tmp/matugen

# --- Flatpak app layer ------------------------------------------------------------
# Callisto follows the immutable-distro split: apt ships the system, Flathub
# ships the applications. The app list lives in package-lists/callisto.flatpaks.txt
# and is installed system-wide here, inside the chroot, so it lands in the
# squashfs. An ISO that is missing apps is a broken ISO, so failures are fatal.
echo "callisto: installing flatpak app layer"
flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo
while IFS= read -r ref; do
    case "$ref" in
        ""|\#*) continue ;;
    esac
    ref="$(echo "$ref" | tr -d '[:space:]')"
    flatpak install --system --noninteractive --assumeyes flathub "$ref"
done < /usr/share/callisto/flatpaks.txt

echo "callisto: setup hook complete"
