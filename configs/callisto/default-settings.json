{
  "version": 1,
  "appearance": {
    "mode": "dark",
    "accent": "planet",
    "contrast": 0.0,
    "material": "mica",
    "themeApps": true,
    "wallpaper": "/usr/share/backgrounds/callisto/wallpaper.jpg"
  },
  "shell": {
    "barPosition": "top",
    "barMode": "auto",
    "revealDelay": 120,
    "clockFormat": "24h",
    "reduceMotion": false
  },
  "windows": {
    "focusFollowsMouse": true,
    "workspaceSwipe": true
  },
  "input": {
    "keyboardLayout": "us",
    "naturalScroll": true,
    "tapToClick": true
  },
  "notifications": {
    "dnd": false,
    "lockscreenNotifications": true
  }
}