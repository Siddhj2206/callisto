#!/bin/sh
# install-prepare ROOT — turn the copied live system into an installed one,
# before the user's account is made.
set -eu
root=${1:?target root}
[ "$root" != / ] && [ -d "$root/etc" ] || { echo "not a target root: $root" >&2; exit 1; }

# The live user has a public password and sudo.
if chroot "$root" id user >/dev/null 2>&1; then
    chroot "$root" userdel -f -r user
fi

# Automatic login belongs to the live session.
sed -i '/^\[initial_session\]/,/^\[default_session\]/{/^\[default_session\]/!d}' "$root/etc/greetd/config.toml"

# Everything else that is only for the live session, the installer included.
while read -r path; do
    case $path in
        '' | '#'*) ;;
        /*) rm -rf "${root:?}$path" ;;
    esac
done <"$root/usr/lib/callisto/live-only"

# The layout chosen in the installer is every new account's starting point.
if [ -f "$root/etc/default/keyboard" ]; then
    XKBLAYOUT=us XKBVARIANT='' XKBOPTIONS=''
    . "$root/etc/default/keyboard"
    case "$XKBLAYOUT$XKBVARIANT$XKBOPTIONS" in
        *[!A-Za-z0-9_,:+-]*) echo "ignoring odd keyboard layout" >&2 ;;
        *)
            mkdir -p "$root/etc/skel/.config/callisto"
            printf '{"version": 1, "input": {"keyboardLayout": "%s", "keyboardVariant": "%s", "keyboardOptions": "%s"}}\n' \
                "${XKBLAYOUT:-us}" "$XKBVARIANT" "$XKBOPTIONS" >"$root/etc/skel/.config/callisto/settings.json"
            ;;
    esac
fi
