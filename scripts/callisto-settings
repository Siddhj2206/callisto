#!/bin/sh
# callisto-settings [PAGE] — open Settings, or bring the open window forward.
# One instance, its own process and systemd scope, apart from the shell.
config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/triton/settings-app.qml"

if qs ipc -p "$config" call settings open "$1" >/dev/null 2>&1; then
    exec hyprctl dispatch 'hl.dsp.focus({ window = "class:org.callisto.Settings" })' >/dev/null
fi

export CALLISTO_SETTINGS_PAGE="$1"
if command -v uwsm >/dev/null 2>&1; then
    exec uwsm app -a callisto-settings -- qs -n -p "$config"
fi
exec qs -n -p "$config"
