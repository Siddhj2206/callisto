#!/usr/bin/env python3
"""callisto-apply — the Triton theme engine.

Compiles the settings store (~/.config/callisto/settings.json) plus the design
tokens into the config formats every target program understands, atomically
and idempotently. This is the ONLY sanctioned writer of these files:

    ~/.config/callisto/tokens.json        (Triton shell reads this)
    ~/.config/gtk-3.0/gtk.css             (+ gtk-4.0)
    ~/.config/callisto/foot-theme.ini     (foot.ini includes it)
    ~/.config/hypr/callisto-user.lua     (hyprland.conf sources it)

Users never edit any of these by hand; the Settings app edits the store and
re-runs this program. See docs/design/settings-architecture.md.

Usage:
    callisto-apply            compile + apply everything, live
    callisto-apply --dry-run  write nothing, print what would change
    callisto-apply --init     compile from defaults only (first-boot seeding)
"""

import json
import os
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STORE = XDG_CONFIG / "callisto" / "settings.json"
SYSTEM_TOKENS = Path("/usr/share/callisto/tokens.json")
DEFAULT_STORE = Path("/usr/share/callisto/default-settings.json")

DRY = "--dry-run" in sys.argv


def log(msg: str) -> None:
    print(f"callisto-apply: {msg}")


def atomic_write(path: Path, content: str) -> bool:
    """Write content to path atomically. Returns True if anything changed."""
    if path.exists() and path.read_text() == content:
        return False
    if DRY:
        log(f"would write {path}")
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    log(f"wrote {path}")
    return True


def load_store() -> dict:
    """The store, merged over system defaults."""
    defaults = {}
    if DEFAULT_STORE.exists():
        defaults = json.loads(DEFAULT_STORE.read_text())
    if STORE.exists():
        user = json.loads(STORE.read_text())
        # shallow-merge per section so a partial user store is valid
        for section, values in user.items():
            if isinstance(values, dict) and isinstance(defaults.get(section), dict):
                defaults[section].update(values)
            else:
                defaults[section] = values
    return defaults


def load_tokens() -> dict:
    if not SYSTEM_TOKENS.exists():
        sys.exit("callisto-apply: design tokens missing at /usr/share/callisto/tokens.json — broken install")
    return json.loads(SYSTEM_TOKENS.read_text())


# --- Scheme resolution -------------------------------------------------------

# Accents are named regions of the wallpaper. "wallpaper" (the default) means
# the dominant color matugen extracts; the named presets are curated fallbacks
# for users who want a fixed identity regardless of wallpaper. Color math is
# matugen's — the engine shells out and reads its JSON, never reimplements
# the tonal palette algorithm.
SCHEME_CACHE = Path.home() / ".cache" / "callisto" / "scheme-cache.json"


def cached_scheme(cache_key: str) -> dict | None:
    """Return a previously computed scheme for this exact input, or None."""
    try:
        cache = json.loads(SCHEME_CACHE.read_text())
        if cache.get("key") == cache_key:
            return cache.get("scheme")
    except Exception:
        pass
    return None


def store_scheme(cache_key: str, scheme: dict) -> None:
    try:
        SCHEME_CACHE.parent.mkdir(parents=True, exist_ok=True)
        SCHEME_CACHE.write_text(json.dumps({"key": cache_key, "scheme": scheme}))
    except Exception:
        pass


def matugen_scheme(image_path: str, contrast: float = 0.0) -> dict | None:
    """Run matugen against a wallpaper, return {token_name: '#rrggbb'} for the
    dark scheme, or None if matugen/image is unavailable. Results are cached
    keyed on path+mtime — every settings write runs the engine, and respawning
    matugen for unrelated keys is how you get a subprocess storm."""
    import shutil
    import subprocess
    if not shutil.which("matugen"):
        log("matugen not installed — keeping default tokens")
        return None
    if not Path(image_path).exists():
        log(f"wallpaper missing: {image_path} — keeping default tokens")
        return None
    try:
        mtime = Path(image_path).stat().st_mtime
    except OSError:
        mtime = 0
    cache_key = f"image:{image_path}:{mtime}:{contrast}"
    hit = cached_scheme(cache_key)
    if hit is not None:
        return hit
    try:
        out = subprocess.run(
            ["matugen", "image", image_path, "--dry-run", "-j", "hex",
             "--type", "scheme-content", "--prefer", "darkness",
             "--contrast", str(contrast)],
            capture_output=True, timeout=30, check=True).stdout
        data = json.loads(out)
    except Exception as e:
        log(f"matugen failed: {e} — keeping default tokens")
        return None
    colors = data.get("colors", {})
    scheme = {"dark": {}, "light": {}}
    for name, entry in colors.items():
        if isinstance(entry, dict):
            if "dark" in entry:
                scheme["dark"][name] = entry["dark"]["color"].upper()
            if "light" in entry:
                scheme["light"][name] = entry["light"]["color"].upper()
    if scheme["dark"]:
        store_scheme(cache_key, scheme)
        return scheme
    return None


# Accents are wallpaper regions on the board. Their exact seed hexes are
# derived from the board's rendered swatches; "wallpaper" means dominant-color
# extraction, a "#rrggbb" string means fully custom, and the names are curated
# seeds. All of them flow through the same matugen scheme generation.
ACCENT_SEEDS = {
    "planet": "#2458C8",
    "hull": "#1B4560",
    "rock": "#4A4D55",
    "shadow": "#23262E",
    "haze": "#4A3D8F",
}


def matugen_color_scheme(hex_seed: str, contrast: float = 0.0) -> dict | None:
    """Scheme from an explicit seed color instead of an image."""
    import shutil
    import subprocess
    if not shutil.which("matugen"):
        return None
    cache_key = f"color:{hex_seed}:{contrast}"
    hit = cached_scheme(cache_key)
    if hit is not None:
        return hit
    try:
        out = subprocess.run(
            ["matugen", "color", "hex", hex_seed, "--dry-run", "-j", "hex",
             "--type", "scheme-content", "--contrast", str(contrast)],
            capture_output=True, timeout=30, check=True).stdout
        data = json.loads(out)
    except Exception as e:
        log(f"matugen color failed: {e}")
        return None
    colors = data.get("colors", {})
    scheme = {"dark": {}, "light": {}}
    for name, entry in colors.items():
        if isinstance(entry, dict):
            if "dark" in entry:
                scheme["dark"][name] = entry["dark"]["color"].upper()
            if "light" in entry:
                scheme["light"][name] = entry["light"]["color"].upper()
    if scheme["dark"]:
        store_scheme(cache_key, scheme)
        return scheme
    return None


def resolve_tokens(store: dict, tokens: dict) -> dict:
    """Wallpaper/preset/custom accent applied onto the token set. The token
    names in tokens.json mirror Material role names, so a matugen scheme maps
    1:1."""
    dark = dict(tokens["color"]["dark"])
    light = dict(tokens["color"].get("light", {}))
    appearance = store.get("appearance", {})
    accent = appearance.get("accent", "wallpaper")
    contrast = appearance.get("contrast", 0.0)
    try:
        contrast = max(-1.0, min(1.0, float(contrast)))
    except (TypeError, ValueError):
        contrast = 0.0
    scheme = None
    if accent == "wallpaper":
        wallpaper = appearance.get(
            "wallpaper", "/usr/share/backgrounds/callisto/wallpaper.jpg")
        kind = appearance.get("wallpaperKind", "")
        # Generative wallpapers have no image file — matugen has nothing to
        # extract. Their seeds are part of the shell's authored scenes; the
        # engine mirrors them so colors still follow the wallpaper choice.
        # Seeds are the scenes' actual dominant colors (WallpaperScene.qml).
        KIND_SEEDS = {
            "dune": "#E58A4B",
            "nebula": "#6B3FA0",
            "ice": "#2F7F9A",
            "dusk": "#4A2C5C",
            "planet": "#1F4FBF",
            "paper": "#CBD3E4",
        }
        if kind and kind in KIND_SEEDS:
            scheme = matugen_color_scheme(KIND_SEEDS[kind], contrast)
        elif wallpaper:
            scheme = matugen_scheme(wallpaper, contrast)
    elif accent in ACCENT_SEEDS:
        scheme = matugen_color_scheme(ACCENT_SEEDS[accent], contrast)
    elif isinstance(accent, str) and accent.startswith("#"):
        scheme = matugen_color_scheme(accent, contrast)
    if scheme:
        # Tokens use snake_case role names identical to matugen's output;
        # unknown roles in either direction are ignored.
        for key, val in scheme.get("dark", {}).items():
            if key in dark:
                dark[key] = val.upper()
        for key, val in scheme.get("light", {}).items():
            if key in light:
                light[key] = val.upper()
    effective = dict(tokens)
    effective["color"] = dict(tokens["color"])
    effective["color"]["dark"] = dark
    effective["color"]["light"] = light
    return effective


# --- Emitters ----------------------------------------------------------------


def emit_triton_tokens(effective: dict, store: dict) -> str:
    out = dict(effective)
    # The shell switches schemes live off this key — external apps only get
    # the active scheme at apply time, but the shell can follow instantly.
    out["active_mode"] = store.get("appearance", {}).get("mode", "dark")
    return json.dumps(out, indent=2) + "\n"


def resolve_mode(mode: str) -> str:
    """auto = light 07:00–19:00 local, dark otherwise. Same rule the shell's
    Theme.resolveMode implements — they must never diverge."""
    if mode != "auto":
        return mode
    import datetime
    h = datetime.datetime.now().hour
    return "light" if 7 <= h < 19 else "dark"


def active_scheme(store: dict, tokens: dict) -> dict:
    """The token map for the active mode — external consumers (foot, gtk,
    qt6ct) can't switch live, so they get the active scheme at apply time."""
    mode = resolve_mode(store.get("appearance", {}).get("mode", "dark"))
    scheme = dict(tokens["color"]["dark"])
    if mode == "light" and tokens["color"].get("light"):
        scheme = dict(tokens["color"]["light"])
    return scheme


def emit_foot_theme(tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    def c(key):
        return dark[key].lstrip("#")
    return f"""# GENERATED by callisto-apply — do not edit (Settings app owns this file).
[colors]
background={c('surface')}
foreground={c('on_surface')}
regular0={c('surface_container_lowest')}
regular1=FFB4AB
regular2=A0D0A8
regular3=FFB59B
regular4={c('primary')}
regular5=C3B8FF
regular6=8AD4D6
regular7={c('on_surface')}
bright0={c('surface_container_high')}
bright1=FFC7BE
bright2=B8E4BF
bright3=FFCFB8
bright4={c('primary')}
bright5=D5CDFF
bright6=A2E4E6
bright7=FFFFFF
"""


def emit_gtk_css(tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    def c(key):
        return dark[key]
    return f"""/* GENERATED by callisto-apply — do not edit (Settings app owns this file).
   Triton accent tokens for GTK apps. GNOME/libadwaita apps read their own
   palette; this overrides the accent so foreign apps read as part of the
   shell rather than unbranded guests. */

@define-color accent_color {c('primary')};
@define-color accent_bg_color {c('primary_container')};
@define-color accent_fg_color {c('on_primary_container')};
@define-color window_bg_color {c('surface')};
@define-color window_fg_color {c('on_surface')};
@define-color view_bg_color {c('surface_container_low')};
@define-color view_fg_color {c('on_surface')};
@define-color headerbar_bg_color {c('surface_container_low')};
@define-color headerbar_fg_color {c('on_surface')};
@define-color card_bg_color {c('surface_container_high')};
@define-color card_fg_color {c('on_surface')};
@define-color dialog_bg_color {c('surface_container_high')};
@define-color dialog_fg_color {c('on_surface')};
"""


def emit_qt6ct_colorscheme(tokens: dict) -> str:
    """qt6ct color scheme in qt5ct/qt6ct's INI palette format. Qt apps pick
    this up via QT_QPA_PLATFORMTHEME=qt6ct — the only channel that reaches
    Qt widgets on a Hyprland session."""
    dark = tokens["color"]["dark"]
    def c(key):
        return dark[key]
    # qt6ct color_scheme format: semicolon-separated rgba groups per palette
    # role in fixed order: window, windowText, base, alternateBase, text,
    # button, buttonText, brightText, highlight, highlightedText, tooltips…
    # qt6ct actually reads its own simplified format of active/inactive/disabled
    # color groups. We emit the canonical two-line form qt6ct writes itself.
    def rgb(key):
        h = dark[key].lstrip("#")
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        return f"#ff{r:02x}{g:02x}{b:02x}"
    # Roles in qt6ct order: Window, WindowText, Base, AlternateBase,
    # ToolTipBase, ToolTipText, Text, Button, ButtonText, BrightText,
    # Highlight, HighlightedText, Link, LinkVisited
    active = [
        rgb("surface"),            # Window
        rgb("on_surface"),         # WindowText
        rgb("surface_container_lowest"),  # Base
        rgb("surface_container_low"),     # AlternateBase
        rgb("surface_container"),  # ToolTipBase
        rgb("on_surface"),         # ToolTipText
        rgb("on_surface"),         # Text
        rgb("surface_container"),  # Button
        rgb("on_surface"),         # ButtonText
        rgb("primary"),            # BrightText
        rgb("primary"),            # Highlight
        rgb("on_primary"),         # HighlightedText
        rgb("primary"),            # Link
        rgb("tertiary"),           # LinkVisited
    ]
    joined = ", ".join(active)
    return f"""# GENERATED by callisto-apply — do not edit (Settings app owns this file).
[ColorScheme]
active_colors={joined}
disabled_colors={joined}
inactive_colors={joined}
"""


def emit_hyprland_user(store: dict, tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    windows = store.get("windows", {})
    input_s = store.get("input", {})
    primary = dark["primary"].lstrip("#")
    inactive = "44474f"
    # Every translucent surface is blurred. Only the "solid" material turns
    # blur and shadows off, which also helps software-rendered machines.
    material = store.get("appearance", {}).get("material", "mica")
    blur_on = "false" if material == "solid" else "true"
    shadow_on = blur_on
    lines = [
        "-- GENERATED by callisto-apply — do not edit (Settings app owns this file).",
        "-- Written from the settings store; regenerated on every apply.",
        "-- Lua module required by hyprland.lua (hyprland 0.55+ config language).",
        "",
        "hl.config({",
        "    decoration = {",
        "        blur = {",
        f"            enabled = {blur_on},",
        "            passes = 3,",
        "        },",
        "        shadow = {",
        f"            enabled = {shadow_on},",
        "        },",
        "    },",
        "    general = {",
        "        col = {",
        f'            active_border = "rgba({primary}aa)",',
        f'            inactive_border = "rgba({inactive}44)",',
        "        },",
        "    },",
        "    input = {",
        f'        kb_layout = "{input_s.get("keyboardLayout", "us")}",',
        f"        follow_mouse = {1 if windows.get('focusFollowsMouse', True) else 0},",
        f"        repeat_rate = {input_s.get('repeatRate', 25) if input_s.get('repeat', True) else 0},",
        f"        repeat_delay = {input_s.get('repeatDelay', 400)},",
        f"        sensitivity = {input_s.get('sensitivity', 0.0)},",
        "        touchpad = {",
        f"            natural_scroll = {'true' if input_s.get('naturalScroll', True) else 'false'},",
        f"            tap_to_click = {'true' if input_s.get('tapToClick', True) else 'false'},",
        "        },",
        "    },",
        "})",
        "",
    ]

    # Monitor scale: persisted rule so the scaling survives restart, not just
    # the live keyword push. Applies to all displays (unnamed glob).
    scale = store.get("display", {}).get("scale", 1.0)
    if scale != 1.0:
        lines.append(f'hl.monitor(",preferred,auto,{scale}")')
        lines.append("")
    return "\n".join(lines)


def apply_live(store: dict, tokens: dict) -> None:
    """Push what can be pushed live right now."""
    if DRY:
        return
    # hyprctl reload is cheap and safe; keyword pushes target the few values
    # that need instant effect. Errors are non-fatal — the compositor may not
    # be running (build-time seeding, greeter phase).
    # Targeted keyword pushes: instant effect, no config reload flicker.
    # Errors are non-fatal — the compositor may not be running (build-time
    # seeding, greeter phase, first boot before Hyprland starts).
    import subprocess
    windows = store.get("windows", {})
    input_s = store.get("input", {})
    # Use the in-memory effective tokens — re-reading our own output file
    # raced/skipped writes and pushed fallback gray borders on accent changes.
    dark = tokens["color"]["dark"]["primary"].lstrip("#")
    inactive = "44474f"
    # Live pushes must speak the Lua engine's dialect: hyprctl keyword is
    # rejected outright under the lua config manager ("keyword can't work
    # with non-legacy parsers"). One eval applies everything atomically.
    repeat_rate = input_s.get("repeatRate", 25) if input_s.get("repeat", True) else 0
    vrr = 1 if store.get("display", {}).get("vrr", True) else 0
    lua = (
        "hl.config({"
        "general = { col = { active_border = \"rgba(%saa)\","
        " inactive_border = \"rgba(%s44)\" } },"
        "input = { kb_layout = \"%s\", follow_mouse = %d,"
        " repeat_rate = %d, repeat_delay = %d, sensitivity = %s,"
        " touchpad = { natural_scroll = %s, tap_to_click = %s } },"
        "misc = { vrr = %d }"
        "})"
    ) % (
        dark, inactive,
        input_s.get("keyboardLayout", "us"),
        1 if windows.get("focusFollowsMouse", True) else 0,
        repeat_rate,
        input_s.get("repeatDelay", 400),
        input_s.get("sensitivity", 0.0),
        "true" if input_s.get("naturalScroll", True) else "false",
        "true" if input_s.get("tapToClick", True) else "false",
        vrr,
    )
    try:
        subprocess.run(["hyprctl", "eval", lua], capture_output=True, timeout=3)
    except Exception:
        pass
    # Monitor scale: a rule, not a config key — eval'd hl.monitor merges it.
    scale = store.get("display", {}).get("scale", 1.0)
    if scale != 1.0:
        try:
            subprocess.run(["hyprctl", "eval",
                            "hl.monitor({ output = \"\", scale = %s })" % scale],
                           capture_output=True, timeout=3)
        except Exception:
            pass

    # Night light: hyprsunset is already running in the session; temperature
    # control is a hyprctl keyword. Store key is display.nightLight.
    nl = store.get("display", {}).get("nightLight", False)
    try:
        subprocess.run(["hyprctl", "hyprsunset", "temperature",
                        "4500" if nl else "6000"],
                       capture_output=True, timeout=3)
    except Exception:
        pass

    # Idle behavior: regenerate hypridle.conf from power.dimIdle/suspendIdle.
    # hypridle cannot reload: it has no SIGHUP handler, so a HUP kills it for
    # good. Restart its unit instead, and only when the config changed.
    power = store.get("power", {})
    dim_idle = power.get("dimIdle", True)
    suspend_idle = power.get("suspendIdle", True)
    idle_lines = [
        "# GENERATED by callisto-apply — do not edit.",
        "general {",
        "    lock_cmd = qs -c triton ipc call lock lock",
        "    before_sleep_cmd = qs -c triton ipc call lock lock",
        "    after_sleep_cmd = hyprctl dispatch dpms on",
        "}",
        "",
    ]
    if dim_idle:
        idle_lines += [
            "listener {",
            "    timeout = 600",
            "    on-timeout = hyprctl dispatch dpms off",
            "    on-resume = hyprctl dispatch dpms on",
            "}",
            "",
        ]
    if suspend_idle:
        idle_lines += [
            "listener {",
            "    timeout = 1200",
            "    on-timeout = systemctl suspend",
            "}",
            "",
        ]
    if atomic_write(HOME / ".config" / "hypr" / "hypridle.conf",
                    "\n".join(idle_lines) + "\n"):
        try:
            subprocess.run(["systemctl", "--user", "try-restart", "hypridle.service"],
                           capture_output=True, timeout=10)
        except Exception:
            pass

    # Power profile: power-profiles-daemon exposes a dbus API, but the CLI is
    # the stable interface and idempotent — setting the active profile is
    # a no-op when unchanged.
    profile = store.get("power", {}).get("profile")
    if profile in ("power-saver", "balanced", "performance"):
        try:
            subprocess.run(["powerprofilesctl", "set", profile],
                           capture_output=True, timeout=5)
        except Exception:
            pass

    # Appearance propagation: xdg-desktop-portal-gtk reads these gsettings
    # keys and republishes them as the freedesktop appearance portal keys —
    # THE channel dark mode reaches GTK4/libadwaita, Firefox, Electron, and
    # flatpaks through. gtk.css can't do any of that.
    appearance = store.get("appearance", {})
    scheme = "prefer-light" if resolve_mode(appearance.get("mode", "dark")) == "light" else "prefer-dark"
    gsettings_keys = [
        ("org.gnome.desktop.interface", "color-scheme", scheme),
        ("org.gnome.desktop.interface", "gtk-theme", "Adwaita"),
        ("org.gnome.desktop.interface", "cursor-theme", "Adwaita"),
        ("org.gnome.desktop.interface", "cursor-size", "24"),
    ]
    for schema, key, val in gsettings_keys:
        try:
            subprocess.run(["gsettings", "set", schema, key, val if val.isdigit() else f"'{val}'"],
                           capture_output=True, timeout=3)
        except Exception:
            pass


def main() -> int:
    store = load_store()
    tokens = load_tokens()
    effective = resolve_tokens(store, tokens)

    changed = []
    if atomic_write(XDG_CONFIG / "callisto" / "tokens.json", emit_triton_tokens(effective, store)):
        changed.append("triton tokens")
    active = {"color": {"dark": active_scheme(store, effective)}}
    if atomic_write(XDG_CONFIG / "callisto" / "foot-theme.ini", emit_foot_theme(active)):
        changed.append("foot theme")
    gtk = emit_gtk_css(active)
    if atomic_write(XDG_CONFIG / "gtk-3.0" / "gtk.css", gtk):
        changed.append("gtk3 css")
    if atomic_write(XDG_CONFIG / "gtk-4.0" / "gtk.css", gtk):
        changed.append("gtk4 css")
    if atomic_write(XDG_CONFIG / "hypr" / "callisto-user.lua", emit_hyprland_user(store, active)):
        changed.append("hyprland user config")
    if atomic_write(XDG_CONFIG / "qt6ct" / "colors" / "callisto.conf", emit_qt6ct_colorscheme(active)):
        changed.append("qt6ct colorscheme")
    qt6ct_conf = "[Appearance]\ncolor_scheme_path=" + str(XDG_CONFIG / "qt6ct" / "colors" / "callisto.conf") + "\ncustom_palette=true\nstyle=Fusion\n"
    atomic_write(XDG_CONFIG / "qt6ct" / "qt6ct.conf", qt6ct_conf)

    apply_live(store, effective)
    if changed:
        log("applied: " + ", ".join(changed))
    else:
        log("nothing changed — store and outputs in sync")
    return 0


if __name__ == "__main__":
    sys.exit(main())
