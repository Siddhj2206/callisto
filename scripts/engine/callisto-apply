#!/usr/bin/env python3
"""callisto-apply — the Triton theme engine.

Compiles the settings store (~/.config/callisto/settings.json) plus the design
tokens into the config formats every target program understands, atomically
and idempotently. This is the ONLY sanctioned writer of these files:

    ~/.config/callisto/tokens.json        (Triton shell reads this)
    ~/.config/gtk-3.0/gtk.css             (+ gtk-4.0)
    ~/.config/callisto/foot-theme.ini     (foot.ini includes it)
    ~/.config/hypr/callisto-user.conf     (hyprland.conf sources it)

Users never edit any of these by hand; the Settings app edits the store and
re-runs this program. See docs/design/settings-architecture.md.

Usage:
    callisto-apply            compile + apply everything, live
    callisto-apply --dry-run  write nothing, print what would change
    callisto-apply --init     compile from defaults only (first-boot seeding)
"""

import json
import os
import sys
import tempfile
from pathlib import Path

XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STORE = XDG_CONFIG / "callisto" / "settings.json"
SYSTEM_TOKENS = Path("/usr/share/callisto/tokens.json")
DEFAULT_STORE = Path("/usr/share/callisto/default-settings.json")

DRY = "--dry-run" in sys.argv


def log(msg: str) -> None:
    print(f"callisto-apply: {msg}")


def atomic_write(path: Path, content: str) -> bool:
    """Write content to path atomically. Returns True if anything changed."""
    if path.exists() and path.read_text() == content:
        return False
    if DRY:
        log(f"would write {path}")
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    log(f"wrote {path}")
    return True


def load_store() -> dict:
    """The store, merged over system defaults."""
    defaults = {}
    if DEFAULT_STORE.exists():
        defaults = json.loads(DEFAULT_STORE.read_text())
    if STORE.exists():
        user = json.loads(STORE.read_text())
        # shallow-merge per section so a partial user store is valid
        for section, values in user.items():
            if isinstance(values, dict) and isinstance(defaults.get(section), dict):
                defaults[section].update(values)
            else:
                defaults[section] = values
    return defaults


def load_tokens() -> dict:
    if not SYSTEM_TOKENS.exists():
        sys.exit("callisto-apply: design tokens missing at /usr/share/callisto/tokens.json — broken install")
    return json.loads(SYSTEM_TOKENS.read_text())


# --- Scheme resolution -------------------------------------------------------

# Accents are named regions of the wallpaper. "wallpaper" (the default) means
# the dominant color matugen extracts; the named presets are curated fallbacks
# for users who want a fixed identity regardless of wallpaper. Color math is
# matugen's — the engine shells out and reads its JSON, never reimplements
# the tonal palette algorithm.
SCHEME_CACHE = Path.home() / ".cache" / "callisto" / "scheme-cache.json"


def cached_scheme(cache_key: str) -> dict | None:
    """Return a previously computed scheme for this exact input, or None."""
    try:
        cache = json.loads(SCHEME_CACHE.read_text())
        if cache.get("key") == cache_key:
            return cache.get("scheme")
    except Exception:
        pass
    return None


def store_scheme(cache_key: str, scheme: dict) -> None:
    try:
        SCHEME_CACHE.parent.mkdir(parents=True, exist_ok=True)
        SCHEME_CACHE.write_text(json.dumps({"key": cache_key, "scheme": scheme}))
    except Exception:
        pass


def matugen_scheme(image_path: str) -> dict | None:
    """Run matugen against a wallpaper, return {token_name: '#rrggbb'} for the
    dark scheme, or None if matugen/image is unavailable. Results are cached
    keyed on path+mtime — every settings write runs the engine, and respawning
    matugen for unrelated keys is how you get a subprocess storm."""
    import shutil
    import subprocess
    if not shutil.which("matugen"):
        log("matugen not installed — keeping default tokens")
        return None
    if not Path(image_path).exists():
        log(f"wallpaper missing: {image_path} — keeping default tokens")
        return None
    try:
        mtime = Path(image_path).stat().st_mtime
    except OSError:
        mtime = 0
    cache_key = f"image:{image_path}:{mtime}"
    hit = cached_scheme(cache_key)
    if hit is not None:
        return hit
    try:
        out = subprocess.run(
            ["matugen", "image", image_path, "--dry-run", "-j", "hex",
             "--type", "scheme-content", "--prefer", "darkness"],
            capture_output=True, timeout=30, check=True).stdout
        data = json.loads(out)
    except Exception as e:
        log(f"matugen failed: {e} — keeping default tokens")
        return None
    colors = data.get("colors", {})
    scheme = {}
    for name, entry in colors.items():
        if isinstance(entry, dict) and "dark" in entry:
            scheme[name] = entry["dark"]["color"].upper()
    if scheme:
        store_scheme(cache_key, scheme)
    return scheme or None


# Accents are wallpaper regions on the board. Their exact seed hexes are
# derived from the board's rendered swatches; "wallpaper" means dominant-color
# extraction, a "#rrggbb" string means fully custom, and the names are curated
# seeds. All of them flow through the same matugen scheme generation.
ACCENT_SEEDS = {
    "planet": "#2458C8",
    "hull": "#1B4560",
    "rock": "#4A4D55",
    "shadow": "#23262E",
    "haze": "#4A3D8F",
}


def matugen_color_scheme(hex_seed: str) -> dict | None:
    """Scheme from an explicit seed color instead of an image."""
    import shutil
    import subprocess
    if not shutil.which("matugen"):
        return None
    cache_key = f"color:{hex_seed}"
    hit = cached_scheme(cache_key)
    if hit is not None:
        return hit
    try:
        out = subprocess.run(
            ["matugen", "color", "hex", hex_seed, "--dry-run", "-j", "hex",
             "--type", "scheme-content"],
            capture_output=True, timeout=30, check=True).stdout
        data = json.loads(out)
    except Exception as e:
        log(f"matugen color failed: {e}")
        return None
    colors = data.get("colors", {})
    scheme = {}
    for name, entry in colors.items():
        if isinstance(entry, dict) and "dark" in entry:
            scheme[name] = entry["dark"]["color"].upper()
    if scheme:
        store_scheme(cache_key, scheme)
    return scheme or None


def resolve_tokens(store: dict, tokens: dict) -> dict:
    """Wallpaper/preset/custom accent applied onto the token set. The token
    names in tokens.json mirror Material role names, so a matugen scheme maps
    1:1."""
    dark = dict(tokens["color"]["dark"])
    appearance = store.get("appearance", {})
    accent = appearance.get("accent", "wallpaper")
    scheme = None
    if accent == "wallpaper":
        wallpaper = appearance.get(
            "wallpaper", "/usr/share/backgrounds/callisto/wallpaper.jpg")
        scheme = matugen_scheme(wallpaper)
    elif accent in ACCENT_SEEDS:
        scheme = matugen_color_scheme(ACCENT_SEEDS[accent])
    elif isinstance(accent, str) and accent.startswith("#"):
        scheme = matugen_color_scheme(accent)
    if scheme:
        # Tokens use snake_case role names identical to matugen's output;
        # unknown roles in either direction are ignored.
        for key, val in scheme.items():
            if key in dark:
                dark[key] = val.upper()
    effective = dict(tokens)
    effective["color"] = dict(tokens["color"])
    effective["color"]["dark"] = dark
    return effective


# --- Emitters ----------------------------------------------------------------


def emit_triton_tokens(effective: dict) -> str:
    return json.dumps(effective, indent=2) + "\n"


def emit_foot_theme(tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    def c(key):
        return dark[key].lstrip("#")
    return f"""# GENERATED by callisto-apply — do not edit (Settings app owns this file).
[colors]
background={c('surface')}
foreground={c('on_surface')}
regular0={c('surface_container_lowest')}
regular1=FFB4AB
regular2=A0D0A8
regular3=FFB59B
regular4={c('primary')}
regular5=C3B8FF
regular6=8AD4D6
regular7={c('on_surface')}
bright0={c('surface_container_high')}
bright1=FFC7BE
bright2=B8E4BF
bright3=FFCFB8
bright4={c('primary')}
bright5=D5CDFF
bright6=A2E4E6
bright7=FFFFFF
"""


def emit_gtk_css(tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    def c(key):
        return dark[key]
    return f"""/* GENERATED by callisto-apply — do not edit (Settings app owns this file).
   Triton accent tokens for GTK apps. GNOME/libadwaita apps read their own
   palette; this overrides the accent so foreign apps read as part of the
   shell rather than unbranded guests. */

@define-color accent_color {c('primary')};
@define-color accent_bg_color {c('primary_container')};
@define-color accent_fg_color {c('on_primary_container')};
@define-color window_bg_color {c('surface')};
@define-color window_fg_color {c('on_surface')};
@define-color view_bg_color {c('surface_container_low')};
@define-color view_fg_color {c('on_surface')};
@define-color headerbar_bg_color {c('surface_container_low')};
@define-color headerbar_fg_color {c('on_surface')};
@define-color card_bg_color {c('surface_container_high')};
@define-color card_fg_color {c('on_surface')};
@define-color dialog_bg_color {c('surface_container_high')};
@define-color dialog_fg_color {c('on_surface')};
"""


def emit_hyprland_user(store: dict, tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    windows = store.get("windows", {})
    input_s = store.get("input", {})
    primary = dark["primary"].lstrip("#")
    inactive = "44474f"
    lines = [
        "# GENERATED by callisto-apply — do not edit (Settings app owns this file).",
        "# Written from the settings store; regenerated on every apply.",
        "",
        "general {",
        f"    col.active_border = rgba({primary}aa)",
        f"    col.inactive_border = rgba({inactive}44)",
        "}",
        "",
        "input {",
        f"    kb_layout = {input_s.get('keyboardLayout', 'us')}",
        f"    follow_mouse = {1 if windows.get('focusFollowsMouse', True) else 0}",
        "    touchpad {",
        f"        natural_scroll = {'true' if input_s.get('naturalScroll', True) else 'false'}",
        f"        tap-to-click = {'true' if input_s.get('tapToClick', True) else 'false'}",
        "    }",
        "}",
        "",
    ]
    return "\n".join(lines)


def apply_live(store: dict, tokens: dict) -> None:
    """Push what can be pushed live right now."""
    if DRY:
        return
    # hyprctl reload is cheap and safe; keyword pushes target the few values
    # that need instant effect. Errors are non-fatal — the compositor may not
    # be running (build-time seeding, greeter phase).
    # Targeted keyword pushes: instant effect, no config reload flicker.
    # Errors are non-fatal — the compositor may not be running (build-time
    # seeding, greeter phase, first boot before Hyprland starts).
    import subprocess
    windows = store.get("windows", {})
    input_s = store.get("input", {})
    # Use the in-memory effective tokens — re-reading our own output file
    # raced/skipped writes and pushed fallback gray borders on accent changes.
    dark = tokens["color"]["dark"]["primary"].lstrip("#")
    inactive = "44474f"
    keywords = [
        ("general:col.active_border", f"rgba({dark}aa)"),
        ("general:col.inactive_border", f"rgba({inactive}44)"),
        ("input:kb_layout", str(input_s.get("keyboardLayout", "us"))),
        ("input:follow_mouse", str(1 if windows.get("focusFollowsMouse", True) else 0)),
        ("input:touchpad:natural_scroll", "true" if input_s.get("naturalScroll", True) else "false"),
        ("input:touchpad:tap-to-click", "true" if input_s.get("tapToClick", True) else "false"),
        ("input:repeat_rate", str(input_s.get("repeatRate", 25))),
        ("input:repeat_delay", str(input_s.get("repeatDelay", 400))),
    ]
    try:
        for key, val in keywords:
            subprocess.run(["hyprctl", "keyword", key, val],
                           capture_output=True, timeout=3)
    except Exception:
        pass


def main() -> int:
    store = load_store()
    tokens = load_tokens()
    effective = resolve_tokens(store, tokens)

    changed = []
    if atomic_write(XDG_CONFIG / "callisto" / "tokens.json", emit_triton_tokens(effective)):
        changed.append("triton tokens")
    if atomic_write(XDG_CONFIG / "callisto" / "foot-theme.ini", emit_foot_theme(effective)):
        changed.append("foot theme")
    gtk = emit_gtk_css(effective)
    if atomic_write(XDG_CONFIG / "gtk-3.0" / "gtk.css", gtk):
        changed.append("gtk3 css")
    if atomic_write(XDG_CONFIG / "gtk-4.0" / "gtk.css", gtk):
        changed.append("gtk4 css")
    if atomic_write(XDG_CONFIG / "hypr" / "callisto-user.conf", emit_hyprland_user(store, effective)):
        changed.append("hyprland user config")

    apply_live(store, effective)
    if changed:
        log("applied: " + ", ".join(changed))
    else:
        log("nothing changed — store and outputs in sync")
    return 0


if __name__ == "__main__":
    sys.exit(main())
