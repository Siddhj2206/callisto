#!/usr/bin/env python3
"""callisto-apply — the Triton theme engine.

Compiles the settings store (~/.config/callisto/settings.json) plus the design
tokens into the config formats every target program understands, atomically
and idempotently. This is the ONLY sanctioned writer of these files:

    ~/.config/callisto/tokens.json        (Triton shell reads this)
    ~/.config/gtk-3.0/gtk.css             (+ gtk-4.0)
    ~/.config/callisto/foot-theme.ini     (foot.ini includes it)
    ~/.config/hypr/callisto-user.lua     (hyprland.lua requires it)

Users never edit any of these by hand. In a session, callisto-settingsd owns
the store and calls apply() here with only the domains that changed. See docs/design/settings-architecture.md.

Usage:
    callisto-apply            compile + apply everything, live
    callisto-apply --dry-run  write nothing, print what would change
    callisto-apply --init     compile from defaults only (first-boot seeding)
"""

import json
import os
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
STORE = XDG_CONFIG / "callisto" / "settings.json"
SYSTEM_TOKENS = Path("/usr/share/callisto/tokens.json")
DEFAULT_STORE = Path("/usr/share/callisto/default-settings.json")

DRY = "--dry-run" in sys.argv


def log(msg: str) -> None:
    print(f"callisto-apply: {msg}")


def atomic_write(path: Path, content: str) -> bool:
    """Write content to path atomically. Returns True if anything changed."""
    if path.exists() and path.read_text() == content:
        return False
    if DRY:
        log(f"would write {path}")
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    # Unique per writer: this and settingsd can both be at work.
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    log(f"wrote {path}")
    return True


def load_store() -> dict:
    """The store, merged over system defaults."""
    defaults = {}
    if DEFAULT_STORE.exists():
        defaults = json.loads(DEFAULT_STORE.read_text())
    if STORE.exists():
        user = json.loads(STORE.read_text())
        # shallow-merge per section so a partial user store is valid
        for section, values in user.items():
            if isinstance(values, dict) and isinstance(defaults.get(section), dict):
                defaults[section].update(values)
            else:
                defaults[section] = values
    return defaults


def load_tokens() -> dict:
    if not SYSTEM_TOKENS.exists():
        sys.exit("callisto-apply: design tokens missing at /usr/share/callisto/tokens.json — broken install")
    return json.loads(SYSTEM_TOKENS.read_text())


# --- Scheme resolution -------------------------------------------------------

# Accents are named regions of the wallpaper. "wallpaper" (the default) means
# the dominant color matugen extracts; the named presets are curated fallbacks
# for users who want a fixed identity regardless of wallpaper. Color math is
# matugen's — the engine shells out and reads its JSON, never reimplements
# the tonal palette algorithm.
SCHEME_CACHE = Path.home() / ".cache" / "callisto" / "scheme-cache.json"


def cached_scheme(cache_key: str) -> dict | None:
    """Return a previously computed scheme for this exact input, or None."""
    try:
        cache = json.loads(SCHEME_CACHE.read_text())
        if cache.get("key") == cache_key:
            return cache.get("scheme")
    except Exception:
        pass
    return None


def store_scheme(cache_key: str, scheme: dict) -> None:
    try:
        SCHEME_CACHE.parent.mkdir(parents=True, exist_ok=True)
        SCHEME_CACHE.write_text(json.dumps({"key": cache_key, "scheme": scheme}))
    except Exception:
        pass


def matugen_scheme(image_path: str, contrast: float = 0.0, remember: bool = True) -> dict | None:
    """Run matugen against a wallpaper, return {token_name: '#rrggbb'} for the
    dark scheme, or None if matugen/image is unavailable. Results are cached
    keyed on path+mtime — every settings write runs the engine, and respawning
    matugen for unrelated keys is how you get a subprocess storm."""
    import shutil
    import subprocess
    if not shutil.which("matugen"):
        log("matugen not installed — keeping default tokens")
        return None
    if not Path(image_path).exists():
        log(f"wallpaper missing: {image_path} — keeping default tokens")
        return None
    try:
        mtime = Path(image_path).stat().st_mtime
    except OSError:
        mtime = 0
    cache_key = f"image:{image_path}:{mtime}:{contrast}"
    hit = cached_scheme(cache_key)
    if hit is not None:
        return hit
    try:
        out = subprocess.run(
            ["matugen", "image", image_path, "--dry-run", "-j", "hex",
             "--type", "scheme-content", "--prefer", "darkness",
             "--contrast", str(contrast)],
            capture_output=True, timeout=30, check=True).stdout
        data = json.loads(out)
    except Exception as e:
        log(f"matugen failed: {e} — keeping default tokens")
        return None
    colors = data.get("colors", {})
    scheme = {"dark": {}, "light": {}}
    for name, entry in colors.items():
        if isinstance(entry, dict):
            if "dark" in entry:
                scheme["dark"][name] = entry["dark"]["color"].upper()
            if "light" in entry:
                scheme["light"][name] = entry["light"]["color"].upper()
    if scheme["dark"]:
        if remember:
            store_scheme(cache_key, scheme)
        return scheme
    return None


# Accents are wallpaper regions on the board, which gives their seed colors
# (SettingsCatalog shows the same). "wallpaper" means dominant-color
# extraction, a "#rrggbb" string means fully custom, and the names are presets. All of them flow through the same matugen scheme generation.
ACCENT_SEEDS = {
    "planet": "#2458C8",
    "hull": "#D8DEE8",
    "rock": "#C0552A",
    "shadow": "#1B2A4A",
    "haze": "#4FA3A5",
}


def matugen_color_scheme(hex_seed: str, contrast: float = 0.0) -> dict | None:
    """Scheme from an explicit seed color instead of an image."""
    import shutil
    import subprocess
    if not shutil.which("matugen"):
        return None
    cache_key = f"color:{hex_seed}:{contrast}"
    hit = cached_scheme(cache_key)
    if hit is not None:
        return hit
    try:
        out = subprocess.run(
            ["matugen", "color", "hex", hex_seed, "--dry-run", "-j", "hex",
             "--type", "scheme-content", "--contrast", str(contrast)],
            capture_output=True, timeout=30, check=True).stdout
        data = json.loads(out)
    except Exception as e:
        log(f"matugen color failed: {e}")
        return None
    colors = data.get("colors", {})
    scheme = {"dark": {}, "light": {}}
    for name, entry in colors.items():
        if isinstance(entry, dict):
            if "dark" in entry:
                scheme["dark"][name] = entry["dark"]["color"].upper()
            if "light" in entry:
                scheme["light"][name] = entry["light"]["color"].upper()
    if scheme["dark"]:
        store_scheme(cache_key, scheme)
        return scheme
    return None


def resolve_tokens(store: dict, tokens: dict) -> dict:
    """Wallpaper/preset/custom accent applied onto the token set. The token
    names in tokens.json mirror Material role names, so a matugen scheme maps
    1:1."""
    dark = dict(tokens["color"]["dark"])
    light = dict(tokens["color"].get("light", {}))
    appearance = store.get("appearance", {})
    accent = appearance.get("accent", "wallpaper")
    contrast = appearance.get("contrast", 0.0)
    try:
        contrast = max(-1.0, min(1.0, float(contrast)))
    except (TypeError, ValueError):
        contrast = 0.0
    scheme = None
    if accent == "wallpaper":
        wallpaper = appearance.get(
            "wallpaper", "/usr/share/backgrounds/callisto/wallpaper.jpg")
        if wallpaper:
            scheme = matugen_scheme(wallpaper, contrast)
    elif accent in ACCENT_SEEDS:
        scheme = matugen_color_scheme(ACCENT_SEEDS[accent], contrast)
    elif isinstance(accent, str) and accent.startswith("#"):
        scheme = matugen_color_scheme(accent, contrast)
    if scheme:
        # Tokens use snake_case role names identical to matugen's output;
        # unknown roles in either direction are ignored.
        for key, val in scheme.get("dark", {}).items():
            if key in dark:
                dark[key] = val.upper()
        for key, val in scheme.get("light", {}).items():
            if key in light:
                light[key] = val.upper()
    effective = dict(tokens)
    effective["color"] = dict(tokens["color"])
    effective["color"]["dark"] = dark
    effective["color"]["light"] = light
    return effective


# --- Emitters ----------------------------------------------------------------


def emit_triton_tokens(effective: dict, store: dict) -> str:
    out = dict(effective)
    # The shell switches schemes live off this key — external apps only get
    # the active scheme at apply time, but the shell can follow instantly.
    out["active_mode"] = store.get("appearance", {}).get("mode", "dark")
    return json.dumps(out, indent=2) + "\n"


def resolve_mode(mode: str) -> str:
    """auto = light 07:00–19:00 local, dark otherwise. Same rule the shell's
    Theme.resolveMode implements — they must never diverge."""
    if mode != "auto":
        return mode
    import datetime
    h = datetime.datetime.now().hour
    return "light" if 7 <= h < 19 else "dark"


def active_scheme(store: dict, tokens: dict) -> dict:
    """The token map for the active mode — external consumers (foot, gtk,
    qt6ct) can't switch live, so they get the active scheme at apply time."""
    mode = resolve_mode(store.get("appearance", {}).get("mode", "dark"))
    scheme = dict(tokens["color"]["dark"])
    if mode == "light" and tokens["color"].get("light"):
        scheme = dict(tokens["color"]["light"])
    return scheme


# The terminal's six hues and their bright forms. Pale on a dark background,
# deep on a light one; scripts/check-contrast.py holds both to 4.5:1.
ANSI = {
    "dark": (("FFB4AB", "A0D0A8", "FFB59B", None, "C3B8FF", "8AD4D6"),
             ("FFC7BE", "B8E4BF", "FFCFB8", None, "D5CDFF", "A2E4E6")),
    "light": (("BA1A1A", "2E6B3A", "8A4B00", None, "6B3FA0", "00696D"),
              ("93000A", "1E5128", "6B3900", None, "532A85", "004F52")),
}


def emit_foot_theme(tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    def c(key):
        return dark[key].lstrip("#")
    surface = [int(c("surface")[i:i + 2], 16) for i in (0, 2, 4)]
    light = sum(surface) > 3 * 128
    # None is blue, which follows the accent.
    regular, bright = ([hue or c("primary") for hue in row] for row in ANSI["light" if light else "dark"])
    hues = "".join(f"regular{i}={hue}\n" for i, hue in enumerate(regular, 1))
    brights = "".join(f"bright{i}={hue}\n" for i, hue in enumerate(bright, 1))
    # "Black" and "white" are the quiet and the loud ink, whichever way round.
    black, white = ("on_surface", "on_surface_variant") if light else ("surface_container_lowest", "on_surface")
    bright_black, bright_white = ("on_surface_variant", c("on_surface")) if light else ("surface_container_high", "FFFFFF")
    return f"""# GENERATED by callisto-apply — do not edit (Settings app owns this file).
[colors]
background={c('surface')}
foreground={c('on_surface')}
regular0={c(black)}
{hues}regular7={c(white)}
bright0={c(bright_black)}
{brights}bright7={bright_white}
"""


def luminance(hex_color: str) -> float:
    value = hex_color.lstrip("#")
    r, g, b = (c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
               for c in (int(value[i:i + 2], 16) / 255 for i in (0, 2, 4)))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def over(color: str, alpha: float, under: str) -> str:
    a, b = color.lstrip("#"), under.lstrip("#")
    return "#" + "".join("%02x" % round(int(a[i:i + 2], 16) * alpha + int(b[i:i + 2], 16) * (1 - alpha))
                         for i in (0, 2, 4))


def legible_alpha(scheme: dict, fill: str, designed: float, material: dict) -> float:
    """The shell's Scheme.legible: the designed opacity, raised until secondary
    text keeps 4.5:1 whatever is behind."""
    light = luminance(scheme["surface"]) > 0.4
    behind = "#000000" if light else "#ffffff"
    alpha = designed
    while alpha < 1:
        under = over(material["ink"], material["veil"], over(scheme[fill], alpha, behind))
        high, low = sorted((luminance(scheme["on_surface_variant"]), luminance(under)), reverse=True)
        if (high + 0.05) / (low + 0.05) >= 4.5:
            return round(alpha, 2)
        alpha += 0.01
    return 1.0


# The named colors libadwaita reads. The list follows dux-shell's template
# (MIT, Avenge Media); the values are Triton's.
GTK_COLORS = (
    ("accent_color", "primary"), ("accent_bg_color", "primary"), ("accent_fg_color", "on_primary"),
    ("destructive_color", "error"), ("destructive_bg_color", "error"), ("destructive_fg_color", "on_error"),
    ("error_color", "error"), ("error_bg_color", "error"), ("error_fg_color", "on_error"),
    ("window_bg_color", "surface_container_low"), ("window_fg_color", "on_surface"),
    ("view_bg_color", "surface_container_low"), ("view_fg_color", "on_surface"),
    ("headerbar_bg_color", "surface_container_low"), ("headerbar_fg_color", "on_surface"),
    ("sidebar_bg_color", "surface_container_low"), ("sidebar_fg_color", "on_surface"),
    ("secondary_sidebar_bg_color", "surface_container_low"), ("secondary_sidebar_fg_color", "on_surface"),
    ("card_bg_color", "surface_container_high"), ("card_fg_color", "on_surface"),
    ("popover_bg_color", "surface_container_high"), ("popover_fg_color", "on_surface"),
    ("dialog_bg_color", "surface_container_high"), ("dialog_fg_color", "on_surface"),
    ("overview_bg_color", "surface_container_high"), ("overview_fg_color", "on_surface"),
)

GTK_BACKDROP = """@define-color headerbar_backdrop_color @window_bg_color;
@define-color sidebar_backdrop_color @sidebar_bg_color;
@define-color secondary_sidebar_backdrop_color @secondary_sidebar_bg_color;
@define-color theme_unfocused_bg_color @window_bg_color;
@define-color theme_unfocused_base_color @view_bg_color;
@define-color theme_unfocused_fg_color @window_fg_color;
@define-color theme_unfocused_text_color @view_fg_color;
"""


def emit_gtk_css(tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    lines = [f"@define-color {name} {dark[role]};" for name, role in GTK_COLORS]
    return ("/* GENERATED by callisto-apply — do not edit (Settings app owns this file). */\n\n"
            + "\n".join(lines) + "\n" + GTK_BACKDROP)


def emit_gtk4_skin(tokens: dict, material: dict, translucent: bool) -> str:
    """The Adwaita board: color, shape and material change; spacing, sizes and
    widget structure do not."""
    dark = tokens["color"]["dark"]
    css = f"""
/* Shape: pills for buttons and rows. Linked buttons keep a joined group. */
button {{ border-radius: 20px; }}
.linked > button {{ border-radius: 8px; }}
.linked > button:first-child {{ border-radius: 20px 8px 8px 20px; }}
.linked > button:last-child {{ border-radius: 8px 20px 20px 8px; }}
.linked > button:only-child {{ border-radius: 20px; }}
entry {{ border-radius: 20px; }}
.navigation-sidebar > row, .navigation-sidebar > child {{ border-radius: 22px; }}
row:selected, columnview > listview > row:selected {{ border-radius: 20px; }}
.navigation-sidebar > row:selected, row:selected, gridview > child:selected {{
    background-color: {dark['secondary_container']};
    color: {dark['on_secondary_container']};
}}
popover > contents {{ border-radius: 20px; }}
popover modelbutton {{ border-radius: 14px; }}
"""
    if translucent:
        def alpha(role, name):
            return "alpha(%s, %s)" % (dark[role], legible_alpha(dark, role, material[name], material))

        # Selectors, not color names: apps such as Files paint their window with
        # their own color. One translucent layer per pixel, so sidebars are
        # clear over the window, and content stays solid.
        css += f"""
window.background {{ background-color: {alpha('surface_container_low', 'mica')}; }}
.sidebar-pane {{ background-color: transparent; }}
.content-pane {{ background-color: {dark['surface_container_low']}; }}
popover > contents, popover > arrow {{ background-color: {alpha('surface_container_high', 'glass')}; }}
"""
    return css


def emit_gtk3_settings(light: bool) -> str:
    """GTK3 has no color-scheme preference, only this switch. GTK4 follows the
    portal and must not see it."""
    return f"""# GENERATED by callisto-apply — do not edit (Settings app owns this file).
[Settings]
gtk-application-prefer-dark-theme={'false' if light else 'true'}
gtk-theme-name=Adwaita
gtk-font-name=Google Sans Flex 11
gtk-cursor-theme-name=Adwaita
"""


# qt6ct wants one color per QPalette::ColorRole, in Qt's enum order, and
# silently ignores the whole file when any are missing. None is NoRole.
QT_ROLES = (
    "on_surface",                 # WindowText
    "surface_container",          # Button
    "surface_container_highest",  # Light
    "surface_container_high",     # Midlight
    "surface_container_lowest",   # Dark
    "surface_container_low",      # Mid
    "on_surface",                 # Text
    "primary",                    # BrightText
    "on_surface",                 # ButtonText
    "surface_container_lowest",   # Base
    "surface",                    # Window
    "shadow",                     # Shadow
    "primary",                    # Highlight
    "on_primary",                 # HighlightedText
    "primary",                    # Link
    "tertiary",                   # LinkVisited
    "surface_container_low",      # AlternateBase
    None,                         # NoRole
    "surface_container_high",     # ToolTipBase
    "on_surface",                 # ToolTipText
    "on_surface_variant",         # PlaceholderText
    "primary",                    # Accent (Qt 6.6)
)
QT_TEXT_ROLES = (0, 6, 8)


def emit_qt6ct_colorscheme(tokens: dict) -> str:
    """qt6ct color scheme. Qt widget apps from Debian pick this up through
    QT_QPA_PLATFORMTHEME=qt6ct; Flatpak Qt apps do not see it."""
    dark = tokens["color"]["dark"]

    def line(disabled=False):
        colors = []
        for index, key in enumerate(QT_ROLES):
            if disabled and index in QT_TEXT_ROLES:
                key = "outline"
            colors.append("#ff" + dark.get(key, "#000000").lstrip("#").lower())
        return ", ".join(colors)

    return f"""# GENERATED by callisto-apply — do not edit (Settings app owns this file).
[ColorScheme]
active_colors={line()}
disabled_colors={line(disabled=True)}
inactive_colors={line()}
"""


def emit_hyprland_user(store: dict, tokens: dict) -> str:
    dark = tokens["color"]["dark"]
    windows = store.get("windows", {})
    input_s = store.get("input", {})
    primary = dark["primary"].lstrip("#")
    inactive = "44474f"
    # Every translucent surface is blurred. Only the "solid" material turns
    # blur and shadows off, which also helps software-rendered machines.
    material = store.get("appearance", {}).get("material", "mica")
    blur_on = "false" if material == "solid" else "true"
    shadow_on = blur_on
    lines = [
        "-- GENERATED by callisto-apply — do not edit (Settings app owns this file).",
        "-- Written from the settings store; regenerated on every apply.",
        "-- Lua module required by hyprland.lua (hyprland 0.55+ config language).",
        "",
        "hl.config({",
        "    decoration = {",
        "        blur = {",
        f"            enabled = {blur_on},",
        "            passes = 3,",
        "        },",
        "        shadow = {",
        f"            enabled = {shadow_on},",
        "        },",
        "    },",
        "    general = {",
        "        col = {",
        f'            active_border = "rgba({primary}aa)",',
        f'            inactive_border = "rgba({inactive}44)",',
        "        },",
        "    },",
        "    input = {",
        f'        kb_layout = "{input_s.get("keyboardLayout", "us")}",',
        f"        follow_mouse = {1 if windows.get('focusFollowsMouse', True) else 0},",
        f"        repeat_rate = {input_s.get('repeatRate', 25) if input_s.get('repeat', True) else 0},",
        f"        repeat_delay = {input_s.get('repeatDelay', 400)},",
        f"        sensitivity = {input_s.get('sensitivity', 0.0)},",
        "        touchpad = {",
        f"            natural_scroll = {'true' if input_s.get('naturalScroll', True) else 'false'},",
        f"            tap_to_click = {'true' if input_s.get('tapToClick', True) else 'false'},",
        "        },",
        "    },",
        "})",
        "",
    ]

    display = store.get("display", {})
    if "vrr" in display:
        lines += ["hl.config({ misc = { vrr = %d } })" % (1 if display["vrr"] else 0), ""]
    # Any scale the user chose, 1.0 included: the session's default rule is
    # "auto", which is not the same thing.
    if "scale" in display:
        lines += [monitor_rule(display["scale"]), ""]
    return "\n".join(lines)


def monitor_rule(scale) -> str:
    return 'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = %s })' % float(scale)


def run_quiet(*command: str, timeout: float = 5) -> None:
    """Errors are not fatal: the compositor or a service may not be running
    (seeding before the session, the greeter, a build)."""
    import subprocess
    try:
        subprocess.run(command, capture_output=True, timeout=timeout)
    except Exception:
        pass


def hypr_eval(lua: str) -> None:
    # The Lua config manager rejects `hyprctl keyword`.
    run_quiet("hyprctl", "eval", lua)


def live_borders(active: dict) -> None:
    primary = active["color"]["dark"]["primary"].lstrip("#")
    hypr_eval('hl.config({ general = { col = { active_border = "rgba(%saa)",'
              ' inactive_border = "rgba(44474f44)" } } })' % primary)


def live_material(store: dict) -> None:
    on = "false" if store.get("appearance", {}).get("material") == "solid" else "true"
    hypr_eval("hl.config({ decoration = { blur = { enabled = %s }, shadow = { enabled = %s } } })" % (on, on))


def live_input(store: dict) -> None:
    windows = store.get("windows", {})
    input_s = store.get("input", {})
    hypr_eval(
        'hl.config({ input = { kb_layout = "%s", follow_mouse = %d, repeat_rate = %d,'
        " repeat_delay = %d, sensitivity = %s,"
        " touchpad = { natural_scroll = %s, tap_to_click = %s } } })" % (
            input_s.get("keyboardLayout", "us"),
            1 if windows.get("focusFollowsMouse", True) else 0,
            input_s.get("repeatRate", 25) if input_s.get("repeat", True) else 0,
            input_s.get("repeatDelay", 400),
            input_s.get("sensitivity", 0.0),
            "true" if input_s.get("naturalScroll", True) else "false",
            "true" if input_s.get("tapToClick", True) else "false",
        ))


def live_display(store: dict) -> None:
    display = store.get("display", {})
    hypr_eval("hl.config({ misc = { vrr = %d } })" % (1 if display.get("vrr", True) else 0))
    if "scale" in display:
        hypr_eval(monitor_rule(display["scale"]))


def live_nightlight(store: dict) -> None:
    on = store.get("display", {}).get("nightLight", False)
    run_quiet("hyprctl", "hyprsunset", "temperature", "4500" if on else "6000")


def live_idle(store: dict) -> None:
    """hypridle cannot reload (a HUP kills it), so restart its unit, and only
    when its config changed."""
    power = store.get("power", {})
    dim_idle = power.get("dimIdle", True)
    suspend_idle = power.get("suspendIdle", True)
    idle_lines = [
        "# GENERATED by callisto-apply — do not edit.",
        "general {",
        "    lock_cmd = qs -c triton ipc call lock lock",
        "    before_sleep_cmd = qs -c triton ipc call lock lock",
        "    after_sleep_cmd = hyprctl dispatch dpms on",
        "}",
        "",
    ]
    if dim_idle:
        idle_lines += [
            "listener {",
            "    timeout = 600",
            "    on-timeout = hyprctl dispatch dpms off",
            "    on-resume = hyprctl dispatch dpms on",
            "}",
            "",
        ]
    if suspend_idle:
        idle_lines += [
            "listener {",
            "    timeout = 1200",
            "    on-timeout = systemctl suspend",
            "}",
            "",
        ]
    if atomic_write(HOME / ".config" / "hypr" / "hypridle.conf",
                    "\n".join(idle_lines) + "\n"):
        run_quiet("systemctl", "--user", "try-restart", "hypridle.service", timeout=10)


def live_appearance_keys(store: dict) -> None:
    # xdg-desktop-portal-gtk republishes these as the appearance portal keys,
    # which is how dark mode reaches GTK4, Firefox, Electron and Flatpaks.
    mode = resolve_mode(store.get("appearance", {}).get("mode", "dark"))
    for key, value in (("color-scheme", "'prefer-light'" if mode == "light" else "'prefer-dark'"),
                       ("gtk-theme", "'Adwaita'"),
                       ("font-name", "'Google Sans Flex 11'"),
                       ("cursor-theme", "'Adwaita'"),
                       ("cursor-size", "24")):
        run_quiet("gsettings", "set", "org.gnome.desktop.interface", key, value)


# What Flatpak apps are allowed to read so that they take our colors.
FLATPAK_THEME_DIRS = ("xdg-config/gtk-3.0", "xdg-config/gtk-4.0")


def live_apps(store: dict) -> None:
    """A per-user override, merged with whatever else the user has set."""
    if store.get("appearance", {}).get("themeApps", True):
        flags = [f"--filesystem={path}:ro" for path in FLATPAK_THEME_DIRS]
    else:
        flags = [f"--nofilesystem={path}" for path in FLATPAK_THEME_DIRS]
    run_quiet("flatpak", "override", "--user", *flags)


def write_palette(store: dict, effective: dict, active: dict) -> list:
    qt6ct_colors = XDG_CONFIG / "qt6ct" / "colors" / "callisto.conf"
    gtk = emit_gtk_css(active)
    mode = resolve_mode(store.get("appearance", {}).get("mode", "dark"))
    translucent = store.get("appearance", {}).get("material") != "solid"
    gtk4 = gtk + emit_gtk4_skin(active, effective["ui"]["material"][mode], translucent)
    outputs = (
        (XDG_CONFIG / "callisto" / "tokens.json", emit_triton_tokens(effective, store), "triton tokens"),
        (XDG_CONFIG / "callisto" / "foot-theme.ini", emit_foot_theme(active), "foot theme"),
        (XDG_CONFIG / "gtk-3.0" / "gtk.css", gtk, "gtk3 css"),
        (XDG_CONFIG / "gtk-3.0" / "settings.ini",
         emit_gtk3_settings(mode == "light"),
         "gtk3 settings"),
        (XDG_CONFIG / "gtk-4.0" / "gtk.css", gtk4, "gtk4 css"),
        (qt6ct_colors, emit_qt6ct_colorscheme(active), "qt6ct colorscheme"),
        (XDG_CONFIG / "qt6ct" / "qt6ct.conf",
         "[Appearance]\ncolor_scheme_path=" + str(qt6ct_colors) + "\ncustom_palette=true\nstyle=Fusion\n",
         "qt6ct config"),
    )
    return [name for path, content, name in outputs if atomic_write(path, content)]


# What a change can touch. settingsd passes only the ones that changed.
DOMAINS = ("palette", "apps", "material", "input", "display", "nightlight", "idle")


def apply(store: dict, domains=DOMAINS) -> list:
    """Compile and push the given domains. Returns what was rewritten."""
    domains = set(domains)
    changed = []
    if domains & {"palette", "material", "input", "display"}:
        effective = resolve_tokens(store, load_tokens())
        active = {"color": {"dark": active_scheme(store, effective)}}
        # The GTK skin follows the material too.
        if domains & {"palette", "material"}:
            changed += write_palette(store, effective, active)
        if atomic_write(XDG_CONFIG / "hypr" / "callisto-user.lua", emit_hyprland_user(store, active)):
            changed.append("hyprland user config")
    if DRY:
        return changed
    if "palette" in domains:
        live_borders(active)
        live_appearance_keys(store)
    for domain, push in (("apps", live_apps), ("material", live_material), ("input", live_input),
                         ("display", live_display), ("nightlight", live_nightlight),
                         ("idle", live_idle)):
        if domain in domains:
            push(store)
    return changed


def preview_scheme(image_path: str) -> int:
    """Print the colors an image would give, as JSON, changing nothing."""
    contrast = load_store().get("appearance", {}).get("contrast", 0.0)
    scheme = matugen_scheme(image_path, contrast, remember=False)
    if not scheme:
        return 1
    print(json.dumps(scheme))
    return 0


def main() -> int:
    if len(sys.argv) == 3 and sys.argv[1] == "--scheme":
        return preview_scheme(sys.argv[2])
    changed = apply(load_store())
    if changed:
        log("applied: " + ", ".join(changed))
    else:
        log("nothing changed — store and outputs in sync")
    return 0


if __name__ == "__main__":
    sys.exit(main())
