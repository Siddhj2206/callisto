#!/usr/bin/env python3
"""Clipboard history watcher: keeps the last 20 text clipboard entries in
~/.cache/callisto/clipboard.json. Runs as a user service for the session.

wl-paste --watch runs the command once per clipboard change; we read the
content ourselves so multi-line text survives exactly (echo/print pipelines
mangle it). Binary/image clipboards are ignored in v0.1 — the picker only
shows text rows."""

import json
import os
import subprocess
import sys
from pathlib import Path

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "callisto"
OUT = CACHE / "clipboard.json"
MAX_ENTRIES = 20


def load() -> list:
    try:
        return json.loads(OUT.read_text())
    except Exception:
        return []


def save(entries: list) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = OUT.with_suffix(".tmp")
    tmp.write_text(json.dumps(entries))
    tmp.replace(OUT)


def current_clipboard() -> str | None:
    try:
        out = subprocess.run(
            ["wl-paste", "--no-newline", "--type", "text"],
            capture_output=True, timeout=3)
        if out.returncode != 0:
            return None
        text = out.stdout.decode("utf-8", errors="replace")
        return text if text.strip() else None
    except Exception:
        return None


def record() -> None:
    text = current_clipboard()
    if text is None:
        return
    entries = load()
    if entries and entries[0].get("text") == text:
        return  # duplicate of latest — most common event by far
    # dedupe: remove earlier copies, newest first
    entries = [e for e in entries if e.get("text") != text]
    entries.insert(0, {
        "text": text,
        "preview": text.strip().replace("\n", " ")[:80],
        "pinned": False,
    })
    # pinned entries survive the cap
    pinned = [e for e in entries if e.get("pinned")]
    rest = [e for e in entries if not e.get("pinned")]
    save((pinned + rest)[:MAX_ENTRIES])


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--once":
        record()
        return 0
    record()  # capture whatever is already there
    # --watch re-invokes this same script per change
    proc = subprocess.run(
        ["wl-paste", "--watch", sys.argv[0], "--once"],
        timeout=None)
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main())
